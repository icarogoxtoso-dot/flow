# Local overrides (não versionar em produção)
# Copie/edite baseado em .env.example quando for subir para VPS.

# Libera login do administrador sem precisar pagar.
ALLOW_ADMIN_LOGIN=true
ALLOW_ADMIN_LOGIN_IN_PROD=false

# Se estiver atrás de proxy (Nginx/Cloudflare), ajuste para true.
TRUST_PROXY=false

