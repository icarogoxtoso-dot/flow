<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow only the public endpoint needed by the app
    RewriteRule ^secure/save_profile\.php$ - [L]

    # Block dotfiles (allow ACME challenge)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Block internal folders and secrets
    RewriteRule ^(secure|storage|scripts|docs)/ - [F,L]
    RewriteRule ^\.env(\.|$) - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^\.env">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
